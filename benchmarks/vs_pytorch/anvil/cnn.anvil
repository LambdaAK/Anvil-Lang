# A LeNet-style CNN on MNIST (conv 8, conv 16, linear), Adam. (torch/cnn.py is the same in PyTorch.)

const EPOCHS = 2
const BATCH = 50

images = idx("../../../examples/data/train-images-idx3-ubyte.gz") / 255
labels: i32[60000] = idx("../../../examples/data/train-labels-idx1-ubyte.gz")
test_images = idx("../../../examples/data/t10k-images-idx3-ubyte.gz") / 255
test_labels: i32[10000] = idx("../../../examples/data/t10k-labels-idx1-ubyte.gz")
X = images.reshape(60000, 1, 28, 28)
X_test = test_images.reshape(10000, 1, 28, 28)

model LeNet:
    c1 = Conv2d(1, 8, 5)        # 28 -> 24 -> pool 12
    c2 = Conv2d(8, 16, 5)       # 12 ->  8 -> pool 4
    fc = Linear(16 * 4 * 4, 10)
    fn forward(x) = x |> c1 |> relu |> max_pool2d |> c2 |> relu |> max_pool2d |> flatten(1) |> fc

net = LeNet()

for epoch in range(EPOCHS):
    t0 = clock()
    for x, y in batches(X, labels, size=BATCH, shuffle=true):
        loss = cross_entropy(net(x), y)
        minimize loss with adam(lr=2e-3)
    print("@epoch {clock() - t0:.5f}")
right = 0.0
for k in range(10):
    t[n, c, i, j] = X_test[k * 1000 + n, c, i, j] where n < 1000
    right = right + accuracy(net(t), test_labels[k * 1000 : k * 1000 + 1000])
print("@metric {right / 10:.4f}")
