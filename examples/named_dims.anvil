# named_dims.anvil — named dimensions turn the shape bugs that train silently into compile errors.
#
#     bin/anvil run examples/named_dims.anvil                  train it (about 3 s)
#     bin/anvil shapes examples/named_dims.anvil               every tensor's shape, by name
#     bin/anvil check examples/named_dims.anvil --set BUG=1    (and 2, 3): one classic bug each
#
# The model reads each MNIST digit as a sequence: ROWS tokens of COLS pixels, one token per row of
# the image. It mixes the rows with self-attention and classifies their average. The sizes collide,
# as sizes do in real programs: the images are square (ROWS = COLS = 28), and the model is as wide as
# the batch (D = BATCH = 64). Each BUG below is one changed line, and with sizes nobody named (all
# that PyTorch or NumPy ever sees) each one runs without a word. BUG 2 and BUG 3 train to about 90%
# instead of 93%: they mix the examples of a batch, so a digit's prediction depends on which other
# digits it was batched with. BUG 1 trains a model of the columns, which does as well on square digits
# and would crash on any other image. Here none of them compiles, because `ROWS` and `COLS`, or `BATCH`
# and `D`, are different dimensions even when they are the same size.

const BUG = 0
const EPOCHS = 3
const BATCH = 64
const ROWS = 28            # tokens: the rows of an image
const COLS = 28            # the features of a token: the pixels of a row
const D = 64               # the model's width
const CLASSES = 10

images = idx("data/train-images-idx3-ubyte.gz") / 255
labels: i32[60000] = idx("data/train-labels-idx1-ubyte.gz")
test_images = idx("data/t10k-images-idx3-ubyte.gz") / 255
test_labels: i32[10000] = idx("data/t10k-labels-idx1-ubyte.gz")
X: [60000, ROWS, COLS] = images              # these annotations name the data file's dimensions
X_test: [10000, ROWS, COLS] = test_images

model RowNet:
    embed = Linear(COLS, D)                   # each row of pixels becomes a D-vector
    param pos: [ROWS, D] ~ normal(0, 0.1)     # and learns where it is
    param Wq: [D, D] ~ normal(0, sqrt(1 / D))
    param Wk: [D, D] ~ normal(0, sqrt(1 / D))
    param Wz: [D, D] ~ normal(0, sqrt(2 / D))
    head = Linear(D, CLASSES)
    fn forward(x):                            # hover x: f32[BATCH, ROWS, COLS]
        if BUG == 1:                          # BUG 1: read each image by columns, not rows
            cols[b, r, c] = x[b, c, r]
            tokens = cols
        else:
            tokens = x
        e[b, r, d] = embed(tokens)[b, r, d] + pos[r, d]
        # RMS norm by hand: each token divided by its own size
        ms[b, r] = sum e[b, r, d] * e[b, r, d] / D
        if BUG == 3:                          # BUG 3: a typo, `ms[d, r]`, divides by another example's size
            h[b, r, d] = e[b, r, d] / sqrt(ms[d, r] + 1e-5)
        else:
            h[b, r, d] = e[b, r, d] / sqrt(ms[b, r] + 1e-5)
        # self-attention over the rows
        q = h @ Wq
        k = h @ Wk
        a[b, r, s] = sum q[b, r, f] * k[b, s, f] / sqrt(D)      # hover a: f32[BATCH, ROWS, ROWS]
        p = softmax(a)
        o[b, r, d] = h[b, r, d] + sum p[b, r, s] * h[b, s, d]
        pooled[b, d] = sum o[b, r, d] / ROWS
        if BUG == 2:                          # BUG 2: the weights on the wrong side of `@`
            z = relu(Wz @ pooled)
        else:
            z = relu(pooled @ Wz)
        return head(z)                        # hover head: forward(x: f32[BATCH, D]) -> f32[BATCH, CLASSES]

net = RowNet()

start = clock()
for epoch in range(EPOCHS):
    for x, y in batches(X, labels, size=BATCH, shuffle=true):
        loss = cross_entropy(net(x), y)
        minimize loss with adam(lr=2e-3)
    right = 0.0
    for k in range(10000 // BATCH):           # the test set, BATCH images at a time
        t[n, r, c] = X_test[k * BATCH + n, r, c] where n < BATCH
        right = right + accuracy(net(t), test_labels[k * BATCH : k * BATCH + BATCH])
    print("epoch {epoch + 1}   loss {loss:.4f}   test accuracy {right / (10000 // BATCH):.2%}   ({clock() - start:.1f}s)")
