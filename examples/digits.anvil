# digits.anvil — train the network that reads hand-drawn digits, and save it for the drawing app.
#
#     bin/anvil run examples/digits.anvil      (then: bin/draw)
#
# A small convolutional network (digits_model.anvil) learns MNIST. Hand-drawn digits are never
# placed as exactly as MNIST's, so every training digit is moved by up to 2 pixels in each
# direction, a different amount every time it is seen.

use "digits_model.anvil"

const EPOCHS = 6
const BATCH = 64
const SAVE = "digits.weights"

images = idx("data/train-images-idx3-ubyte.gz") / 255
labels: i32[60000] = idx("data/train-labels-idx1-ubyte.gz")
test_images = idx("data/t10k-images-idx3-ubyte.gz") / 255
test_labels: i32[10000] = idx("data/t10k-labels-idx1-ubyte.gz")
X = images.reshape(60000, 1, 28, 28)
X_test = test_images.reshape(10000, 1, 28, 28)

net = DigitNet()

start = clock()
for epoch in range(EPOCHS):
    for x, y in batches(X, labels, size=BATCH, shuffle=true):
        # move each digit: put it in a 32×32 frame, then cut a 28×28 window at a random place
        padded: [BATCH, 1, 32, 32] = 0
        padded[n, c, i + 2, j + 2] += x[n, c, i, j]
        dy: i32[BATCH] ~ randint(0, 5)
        dx: i32[BATCH] ~ randint(0, 5)
        moved[n, c, i, j] = padded[n, c, dy[n] + i, dx[n] + j] where i < 28, j < 28
        loss = cross_entropy(net(moved), y)
        minimize loss with adam(lr=1e-3)
    # test on all 10,000 test digits, 1,000 at a time
    correct = 0.0
    for k in range(10):
        correct = correct + accuracy(net(X_test[k * 1000 : k * 1000 + 1000]), test_labels[k * 1000 : k * 1000 + 1000])
    print("epoch {epoch + 1}   loss {loss:.4f}   test accuracy {correct / 10:.2%}   ({clock() - start:.1f}s)")

save(net, SAVE)
print("saved the network to {SAVE}: draw digits for it with bin/draw")
