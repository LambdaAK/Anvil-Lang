# synth_model.anvil — a transformer that writes Pipes programs (examples/synth/pipes.py) by diffusion.
#
# The input is 80 tokens: four examples of what the program should do (input list, output), then the
# program's 24 tokens. While it learns, a random fraction of the program's tokens are hidden ([MASK])
# and it guesses them all at once. To write a program it starts from 24 masks and, step by step,
# fixes the token it is surest of, until none is left: masked diffusion, as in MDLM and LLaDA.
# synth.anvil trains it; synth/write.py asks it for programs.

const VOCAB = 227            # tokens: see pipes.py
const SPEC = 56              # 4 examples of 14 tokens
const PROGRAM = 24           # program tokens
const SEQ = SPEC + PROGRAM
const PAD = 0
const MASK = 1
const D = 256
const HEADS = 8
const DH = D // HEADS
const LAYERS = 6

# a pre-norm transformer block that attends both ways: every token sees the examples and the whole
# program written so far
model Block:
    norm1 = LayerNorm(D)
    q = Linear(D, D)
    k = Linear(D, D)
    v = Linear(D, D)
    o = Linear(D, D)
    norm2 = LayerNorm(D)
    up = Linear(D, 4 * D)
    down = Linear(4 * D, D)
    fn forward(x: [n, SEQ, D]):
        h = norm1(x)
        qs = q(h).reshape(-1, SEQ, HEADS, DH)
        ks = k(h).reshape(-1, SEQ, HEADS, DH)
        vs = v(h).reshape(-1, SEQ, HEADS, DH)
        s[b, a, i, j] = sum qs[b, i, a, e] * ks[b, j, a, e] / sqrt(DH)
        mixed[b, i, a, e] = sum softmax(s)[b, a, i, j] * vs[b, j, a, e]
        x = x + o(mixed.reshape(-1, SEQ, D))
        return x + down(gelu(up(norm2(x))))

model Writer:
    param E: [VOCAB, D] ~ normal(0, 0.02)
    param P: [SEQ, D] ~ normal(0, 0.02)
    blocks = [Block() for k in range(LAYERS)]
    norm = LayerNorm(D)
    out = Linear(D, VOCAB)
    # tokens: i32[n, SEQ], examples then program (hidden tokens are MASK); scores for every program
    # token, [n, PROGRAM, VOCAB]
    fn forward(tokens: i32[n, SEQ]):
        x[b, t, d] = E[tokens[b, t], d] + P[t, d]
        static for block in blocks:
            x = block(x)
        return out(norm(x)[:, SPEC:SEQ, :])

# Fill in the hidden tokens of programs: seq is i32[n, SEQ], the examples and then a program in which
# some (or all) tokens are MASK. At each step the token the model is surest of is fixed, until none is
# hidden. noise: uniform numbers in (0, 1], [n, PROGRAM, VOCAB], for sampling (heat 0: the likeliest
# token, heat 1: a sample). pads_last: fix the program's words before the padding after it (the
# model is surest of padding, so otherwise it settles a program's length first and its words last;
# for the likeliest program that is a little worse, and less fun to watch).
# Returns the programs, i32[n, PROGRAM], and every step, i32[PROGRAM, n, PROGRAM] (after the last
# hidden token is fixed, the steps repeat the programs).
fn fill(net, seq: i32[n, SEQ], noise, heat, pads_last = false):
    s = copy(seq)
    prog = copy(seq[:, SPEC:SEQ])
    gumbel = -log(-log(noise))
    steps: i32[PROGRAM, n, PROGRAM] = MASK
    for step in range(PROGRAM):
        if sum(f32(prog == MASK)) == 0:
            steps[step] = prog
        else:
            scores = net(s)
            guess = argmax(scores + heat * gumbel)
            p = softmax(scores)
            sure[b, i] = p[b, i, guess[b, i]] - (2.0 if pads_last and guess[b, i] == PAD else 0.0) if prog[b, i] == MASK else -9.0
            where = argmax(sure)
            prog[b, i] = guess[b, i] if i == where[b] and prog[b, i] == MASK else prog[b, i]
            s[:, SPEC:SEQ] = prog
            steps[step] = prog
    return prog, steps

# Programs for the examples in spec (i32[n, SPEC]), from all masks.
fn write(net, spec: i32[n, SPEC], heat, pads_last = false):
    seq: i32[n, SEQ] = MASK
    seq[:, 0:SPEC] = spec
    u: [n, PROGRAM, VOCAB] ~ uniform(1e-6, 1)
    return fill(net, seq, u, heat, pads_last)
