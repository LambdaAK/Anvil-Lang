{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" }, { "open": "(", "close": ")" },
    { "open": "{", "close": "}" }, { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["\"", "\""]],
  "onEnterRules": [
    { "beforeText": ":\\s*(#.*)?$", "action": { "indent": "indent" } }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(else|elif)\\b.*:"
  }
}
